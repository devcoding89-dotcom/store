# TownSquare Marketplace Environment Variables
PORT=3001

# Private admin password. Set this only in the server environment; never use a VITE_ prefix.
ADMIN_PASSWORD=replace-with-a-long-random-password

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Groq AI Key (get free from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key
OPENAI_API_KEY=

# Store Owner WhatsApp Number (Country code without +, e.g., 2349138987295)
OWNER_WHATSAPP=2349138987295
VITE_OWNER_WHATSAPP=2349138987295
